# Copy to a git-ignored file (e.g. .env.local) and fill in. Never commit real values.
# Keep comments on their own lines: text after a value becomes part of the value.

# Supabase "Transaction pooler" connection string (port 6543). Remove the [ ] around the password.
DATABASE_URL=
# Supabase "Session pooler" connection string (port 5432). Used only by `pnpm db:migrate`.
# (The "Direct connection" host is IPv6-only on the free plan and fails on most home networks.)
DATABASE_URL_DIRECT=
# 32+ random characters. Seals session cookies and salts IP hashes. Different per environment.
APP_SECRET=
# Shared with the Supabase pg_cron job that calls /api/internal/jobs/drain. Different per environment.
CRON_SECRET=
# Becomes ADMIN on first sign-in.
OWNER_EMAIL=
# Magic-link emails. Leave empty in development: the link is printed to the console instead.
RESEND_API_KEY=
MAIL_FROM=
# "1" on the public demo deployment only.
DEMO_MODE=
