# Copy to .env.local for development. Never commit real values.
DATABASE_URL=                # Supabase pooled connection (transaction mode, port 6543)
DATABASE_URL_DIRECT=         # Supabase direct connection, used only by `pnpm db:migrate`
APP_SECRET=                  # ≥ 32 random characters; seals session cookies and salts IP hashes
CRON_SECRET=                 # shared with the Supabase pg_cron job that calls /api/internal/jobs/drain
OWNER_EMAIL=                 # becomes ADMIN on first sign-in
RESEND_API_KEY=              # magic-link emails; unset in dev = link printed to the console
MAIL_FROM=
DEMO_MODE=                   # "1" on the public demo deployment only
