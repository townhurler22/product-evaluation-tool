# Copy to a git-ignored file (e.g. .env.local) and fill in. Never commit real values.
# Keep comments on their own lines: text after a value becomes part of the value.

# Supabase "Transaction pooler" connection string (port 6543). Remove the [ ] around the password.
DATABASE_URL=
# Supabase "Session pooler" connection string (port 5432). Used only by `pnpm db:migrate`.
# (The "Direct connection" host is IPv6-only on the free plan and fails on most home networks.)
DATABASE_URL_DIRECT=
# 32+ random characters. Seals session cookies and salts IP hashes. Different per environment.
APP_SECRET=
# Shared with the Supabase pg_cron job that calls /api/internal/jobs/drain. Different per environment.
CRON_SECRET=
# Becomes ADMIN on first sign-in.
OWNER_EMAIL=
# Magic-link emails. Leave empty in development: the link is printed to the console instead.
RESEND_API_KEY=
MAIL_FROM=
# "1" on the public demo deployment only.
DEMO_MODE=

# Supabase project URL and keys (Project Settings -> API). Server only: never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> JWT Keys -> Legacy JWT secret. Signs short-lived realtime channel tokens.
SUPABASE_JWT_SECRET=
# Project Settings -> API -> anon (publishable) key. Public by design; the browser needs it to open realtime
# channels. Without it (or without SUPABASE_JWT_SECRET) boards fall back to polling for changes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Intake: 32+ random bytes, different per environment. Missing = intake answers 503 (ING-06).
INGEST_MASTER_KEY=
# staging or production
INGEST_ENVIRONMENT=
# The deployed origin, e.g. https://pet-demo.vercel.app (used for CSRF and links).
APP_ORIGIN=
